# 单任务（向后兼容）
PIPELINE_CONFIG=configs/examples/dataloader_norm_test.yaml

# 多任务（二选一，优先级高于 PIPELINE_CONFIG）
# 1) CSV：用逗号分隔多个配置
PIPELINE_CONFIGS=
# 2) 文件：每行一个配置路径，支持 # 注释
PIPELINE_CONFIG_LIST_FILE=
# 3) 串行分阶段编排（优先级最高）
PIPELINE_SERIAL_PLAN=

PIPELINE_RESUME=true
PIPELINE_CONTINUE_ON_ERROR=false
PIPELINE_LOG_DIR=/workspace/artifacts/logs
# 总控日志（任务内详细日志会自动按配置名拆分）
PIPELINE_LOG_FILE=/workspace/artifacts/logs/managed_pipeline.log
